# Рабочий сервер. Для разработки на своём компьютере: APP_ENV=local, APP_DEBUG=true, APP_URL=http://localhost:8000
APP_NAME="Kassa i Sklad"
APP_ENV=production
# Сгенерируйте: php artisan key:generate --force
APP_KEY=
# true показывает внутренности ошибок посторонним — на рабочем сервере только false
APP_DEBUG=false
APP_TIMEZONE=UTC
# Публичный адрес сервера, только HTTPS (камера-сканер и установка на телефон работают только по HTTPS)
APP_URL=https://kassa.example.uz
AUTH_PUBLIC_REGISTRATION=false
AUTH_REGISTER_THROTTLE=3,10
AUTH_FORGOT_PASSWORD_THROTTLE=5,10
# true — cookie только по HTTPS (обязательно на рабочем сервере)
SESSION_SECURE_COOKIE=true

# Comma-separated domains allowed for Sanctum stateful (cookie) auth.
# WARNING: localhost entries are for local dev only; set your production domain in production.
SANCTUM_STATEFUL_DOMAINS=kassa.example.uz
# API token lifetime in minutes (default 24h). Do not leave empty.
SANCTUM_TOKEN_EXPIRATION=1440

# Set to a public URL when using Midtrans/Xendit webhooks
XENDIT_CALLBACK_TOKEN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# База — один файл SQLite, сервер MySQL не нужен. По умолчанию database/database.sqlite;
# можно указать абсолютный путь: DB_DATABASE=/var/www/kassa/database/database.sqlite
# Папка с базой должна быть доступна веб-серверу на запись (рядом создаются файлы -wal и -shm).
DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=10000
DB_JOURNAL_MODE=wal
DB_SYNCHRONOUS=normal
DB_TRANSACTION_MODE=IMMEDIATE
# Если всё-таки нужен MySQL: DB_CONNECTION=mysql и DB_HOST / DB_PORT / DB_DATABASE / DB_USERNAME / DB_PASSWORD

# Сессии и кэш в файлах — меньше одновременных записей в SQLite
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_VERSION=v3.0.3

# WhatsApp Gateway (whatsapp-web.js service)
WA_SERVICE_URL=http://localhost:3001
# Shared secret for the Node WhatsApp service (must match WA_SERVICE_TOKEN in whatsapp-service).
WA_SERVICE_TOKEN=

# Payment Gateway — Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Payment Gateway — Xendit
XENDIT_SECRET_KEY=
XENDIT_IS_PRODUCTION=false

# Inertia SSR (config/inertia.php)
INERTIA_SSR_ENABLED=true
INERTIA_SSR_RUNTIME=node
INERTIA_SSR_ENSURE_RUNTIME_EXISTS=false
INERTIA_SSR_URL=http://127.0.0.1:13714
INERTIA_SSR_ENSURE_BUNDLE_EXISTS=true
INERTIA_SSR_THROW_ON_ERROR=false
INERTIA_ENCRYPT_HISTORY=false

# Security bot guard (config/security.php)
SECURITY_BOT_GUARD_ENABLED=true
SECURITY_BOT_GUARD_HONEYPOT_FIELD=company_website
SECURITY_BOT_GUARD_TOKEN_FIELD=bot_guard_token
SECURITY_BOT_GUARD_MIN_SUBMIT_SECONDS=2
SECURITY_BOT_GUARD_TOKEN_TTL_SECONDS=1800
SECURITY_BOT_GUARD_MESSAGE="Permintaan tidak valid. Silakan coba lagi."

# Security session (config/security.php)
SECURITY_SESSION_ABSOLUTE_LIFETIME_SECONDS=43200
AUTH_PASSWORD_TIMEOUT=900

# Optional mail providers
RESEND_KEY=
POSTMARK_TOKEN=

# Optional Slack logging
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# Optional Sentry (leave empty to disable)
SENTRY_LARAVEL_DSN=

# «Касса и склад» (public/kassa, /api/kassa)
# Часовой пояс магазина: по нему считаются «сегодня», неделя, месяц и графики
KASSA_TIMEZONE=Asia/Tashkent
# Код установки: без него мастер первого запуска на рабочем сервере закрыт, чтобы магазин не занял посторонний.
# Сгенерируйте: openssl rand -hex 6  — и введите в мастере один раз при создании магазина.
KASSA_SETUP_CODE=
# Сколько дней действует вход сотрудника без активности
KASSA_TOKEN_TTL_DAYS=30
# Демо-магазин (kassa:demo и кнопки «Загрузить демо»). При APP_ENV=production не работает в любом случае.
KASSA_DEMO_ENABLED=false

# Ресторан: приложения /admin, /waiter, /cashier, /kitchen (docs/restaurant.md)
# local — сервер в ресторане (работает в локальной сети без интернета), online — облачная копия (сводная админка, меню, отчёты)
DEPLOY_MODE=local
# Ежедневная синхронизация локального сервера с онлайн-сервером, время ресторана (KASSA_TIMEZONE)
RESTAURANT_SYNC_TIME=03:40
RESTAURANT_SYNC_TIMEOUT=30
# Сетевой принтер кухни: ожидание соединения (с) и число попыток, после которых чек помечается «не напечатан»
RESTAURANT_PRINTER_TIMEOUT=3
RESTAURANT_PRINTER_MAX_ATTEMPTS=10
# Платёжный терминал кассы: включается, адрес, порт и тестовый режим — в админке (Настройки → Платёжный терминал).
# Драйвер настоящего терминала: json — протокол-образец (JSON по TCP); драйвер конкретной модели и банка добавляется
# в config/restaurant.php (docs/restaurant.md, раздел 1.8). Таймаут запроса (с) и сколько ждать оплату гостем (с).
RESTAURANT_TERMINAL_DRIVER=json
RESTAURANT_TERMINAL_TIMEOUT=5
RESTAURANT_TERMINAL_WAIT=180
